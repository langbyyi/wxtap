{
  "name": "wxtap-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json --noEmit && esbuild src/cli.ts --bundle --platform=node --format=esm --external:frida --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/cli.js",
    "test": "vitest run && node scripts/check-dist.mjs",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "frida": "^17.3.2",
    "js-beautify": "^2.0.3",
    "protobufjs": "^7.5.4",
    "ws": "^8.18.3"
  }
}
