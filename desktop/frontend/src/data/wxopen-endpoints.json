      "method": "POST",
      "path": "/cgi-bin/openapi/quota/get",
      "json_body": true,
      "returns": "json",
      "params": [
        {
          "id": "cgi_path",
          "label": "cgi_path",
          "kind": "string",
          "required": true,
          "hint": "如 /cgi-bin/user/get"
        }
      ]
    },
    {
      "id": "oa-rid-get",
      "group": "oa",
      "label": "接口错误详情",
      "category": "系统信息",
      "summary": "按 rid 读取某次调用的详细错误信息。",
      "method": "POST",
      "path": "/cgi-bin/openapi/rid/get",
      "json_body": true,
      "returns": "json",
      "params": [
