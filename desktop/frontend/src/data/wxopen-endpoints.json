    {
      "id": "mini-media-check",
      "group": "mini",
      "label": "图片/音频异步检测",
      "category": "内容安全",
      "summary": "提交图片或音频地址做内容安全检测，确认服务端的媒体拦截口径。",
      "method": "POST",
      "path": "/wxa/media_check_async",
      "json_body": true,
      "returns": "json",
      "note": "结果是异步的（返回 trace_id）；V2 同样要求 openid 在近两小时内访问过小程序。",
      "params": [
        {
          "id": "media_url",
          "label": "media_url",
          "kind": "string",
          "required": true,
          "hint": "可公网访问的图片或音频地址"
        },
        {
          "id": "media_type",
          "label": "media_type",
          "kind": "number",
          "required": true,
          "hint": "1 音频 2 图片",
          "default": "2"
        },
        {
          "id": "version",
          "label": "version",
          "kind": "number",
          "default": "2"
        },
        {
          "id": "openid",
          "label": "openid",
          "kind": "string",
          "required": true,
          "shared": true
        },
        {
          "id": "scene",
          "label": "scene",
          "kind": "number",
          "default": "1",
          "shared": true
        }
      ]
    },
    {
