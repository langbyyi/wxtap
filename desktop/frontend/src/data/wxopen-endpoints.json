      "method": "POST",
      "path": "/cgi-bin/user/info/batchget",
      "json_body": true,
      "returns": "json",
      "params": [
        {
          "id": "user_list",
          "label": "user_list",
          "kind": "json",
          "required": true,
          "hint": "JSON 数组，如 [{\"openid\":\"o1\",\"lang\":\"zh_CN\"}]，最多 100 个"
        }
      ]
    },
    {
      "id": "oa-tags",
