{
  "endpoints": [
    {
      "id": "mini-code-unlimited",
      "group": "mini",
      "label": "生成小程序码（不限量）",
      "category": "小程序码",
      "summary": "为任意页面路径和 scene 参数生成可扫描的小程序码，用于验证站外直达与页面参数是否受限。",
      "method": "POST",
      "path": "/wxa/getwxacodeunlimit",
      "json_body": true,
      "returns": "image",
      "note": "check_path 为 false 时允许页面未发布或不存在（上限 60000 个页面）；page 必须与 app.json 一致且不能带参数，参数走 scene。",
      "params": [
        {
          "id": "scene",
          "label": "scene",
          "kind": "string",
          "required": true,
          "hint": "最多 32 个可见字符，随码进入页面"
        },
        {
          "id": "page",
          "label": "page",
          "kind": "string",
          "hint": "如 pages/admin/index，不带前导 /、不带参数；留空进首页",
          "shared": true
        },
        {
          "id": "check_path",
          "label": "check_path",
          "kind": "bool",
          "default": "false"
        },
        {
          "id": "env_version",
          "label": "env_version",
          "kind": "string",
          "hint": "release | trial | develop，默认 release",
          "shared": true
        },
        {
          "id": "width",
          "label": "width",
          "kind": "number",
          "hint": "280..1280，默认 430",
          "shared": true
        }
      ]
    },
    {
      "id": "mini-code-path",
      "group": "mini",
      "label": "生成小程序码（按路径）",
      "category": "小程序码",
      "summary": "按已发布页面路径生成小程序码，路径必须存在。",
      "method": "POST",
      "path": "/wxa/getwxacode",
      "json_body": true,
      "returns": "image",
      "params": [
        {
          "id": "path",
          "label": "path",
          "kind": "string",
          "required": true,
          "hint": "如 pages/index/index"
        },
        {
          "id": "width",
          "label": "width",
          "kind": "number",
          "shared": true
        }
      ]
    },
    {
      "id": "mini-qrcode",
      "group": "mini",
      "label": "生成普通二维码",
      "category": "小程序码",
      "summary": "生成指向小程序页面的普通二维码。",
      "method": "POST",
      "path": "/cgi-bin/wxaapp/createwxaqrcode",
      "json_body": true,
      "returns": "image",
      "params": [
        {
          "id": "path",
          "label": "path",
          "kind": "string",
          "required": true
        },
        {
          "id": "width",
          "label": "width",
          "kind": "number",
          "shared": true
        }
      ]
    },
    {
      "id": "mini-sec-check",
      "group": "mini",
      "label": "内容安全检测",
      "category": "内容安全",
      "summary": "提交文本到内容安全接口，确认服务端检测能力与拦截口径。",
      "method": "POST",
      "path": "/wxa/msg_sec_check",
      "json_body": true,
      "returns": "json",
      "note": "V2 接口：openid 必填，且该用户需在近两小时内访问过小程序，否则返回 61010。",
      "params": [
        {
          "id": "content",
          "label": "content",
          "kind": "string",
          "required": true
        },
        {
          "id": "version",
          "label": "version",
          "kind": "number",
          "default": "2"
        },
        {
          "id": "scene",
          "label": "scene",
          "kind": "number",
          "hint": "1 资料 2 评论 3 论坛 4 社交日志",
          "default": "1"
        },
        {
          "id": "openid",
          "label": "openid",
          "kind": "string",
          "required": true,
          "hint": "近两小时内访问过小程序的用户 openid",
          "shared": true
        }
      ]
    },
    {
      "id": "mini-account-info",
      "group": "mini",
      "label": "小程序基本信息",
      "category": "账号信息",
      "summary": "读取小程序的名称、主体、类目等账号信息。",
      "method": "POST",
      "path": "/cgi-bin/account/getaccountbasicinfo",
      "json_body": true,
      "returns": "json"
    },
    {
