      "method": "GET",
      "path": "/cgi-bin/user/get",
      "json_body": false,
      "returns": "json",
      "note": "一次最多返回 10000 个 openid；用返回的 next_openid 继续翻页，total 是关注者总数。",
      "params": [
        {
          "id": "next_openid",
          "label": "next_openid",
          "kind": "string",
          "hint": "留空从第一页开始",
          "shared": true
        }
      ]
    },
    {
      "id": "oa-user-info",
