      "returns": "json",
      "params": [
        {
          "id": "openid",
          "label": "openid",
          "kind": "string",
          "required": true,
          "shared": true
        },
        {
          "id": "lang",
          "label": "lang",
          "kind": "string",
          "default": "zh_CN",
          "shared": true
        }
      ]
    },
    {
